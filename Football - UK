S2003 = pd.read_csv("https://football-data.co.uk/mmz4281/0203/E0.csv", encoding="ISO-8859-1",      # <-- FIX 1
    on_bad_lines="skip")

combined_1 = pd.concat([S2003, S2004, S2005, S2006, S2007, S2008, S2009], ignore_index=True)
combined_2 = pd.concat([S2010, S2011, S2012, S2013, S2014, S2015, S2016, S2017,
                         S2018, S2019, S2020, S2021, S2022, S2023, S2024, S2025, S2026], ignore_index=True)


# FIX: Convert Date to datetime BEFORE using .dt
# -------------------------------
combined_1["Date"] = combined_1["Date"].astype(str).str.strip()
combined_2["Date"] = combined_2["Date"].astype(str).str.strip()
combined_1["Date"] = pd.to_datetime(combined_1["Date"], format='mixed', dayfirst=True, errors="coerce")
combined_2["Date"] = pd.to_datetime(combined_2["Date"], format='mixed', dayfirst=True, errors="coerce")
#Concat all DF's
all_df = pd.concat([combined_1, combined_2], ignore_index=True)

# Extract year
all_df["Year"] = all_df["Date"].dt.year .astype("Int64")

#all_df["Date"] = all_df["Date"].dt.strftime("%Y-%m-%d")
all_df["Date"] = all_df["Date"].dt.date

#=================================================================================================#
#Referee that Matches was Join
referee_summary = all_df.groupby("Referee").agg(
    Total_Matches=("Referee", "size"),
    Years_Worked=("Year", lambda x: sorted(x.dropna().unique()))
).sort_values(by="Total_Matches", ascending=False)
print(referee_summary)
