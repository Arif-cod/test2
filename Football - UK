#Cards & Teams
home_cards = (
    all_df.groupby("HomeTeam")[["HY", "HR"]]
          .sum()
          .reset_index()
          .rename(columns={
              "HomeTeam": "Team",
              "HY": "Home_Yellow_Cards",
              "HR": "Home_Red_Cards"
          })
)

print(home_cards)


# Total home cards
home_cards = all_df.groupby("HomeTeam")[["HY", "HR"]].sum()
home_cards.columns = ["HY_home", "HR_home"]

# Total away cards
away_cards = all_df.groupby("AwayTeam")[["AY", "AR"]].sum()
away_cards.columns = ["AY_away", "AR_away"]

# Combine
total_cards = (
    home_cards.join(away_cards, how="outer")
              .fillna(0)
              .reset_index()
              .rename(columns={"index": "Team"})
)

# Total cards
total_cards["Total_Yellow"] = total_cards["HY_home"] + total_cards["AY_away"]
total_cards["Total_Red"] = total_cards["HR_home"] + total_cards["AR_away"]

print(total_cards)




